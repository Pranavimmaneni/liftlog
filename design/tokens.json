  "type": {
    "display": {
      "family": "Big Shoulders Display",
      "weights": [
        700,
        800,
        900
      ],
      "transform": "uppercase",
      "npm": "@fontsource/big-shoulders-display"
    },
    "body": {
      "family": "Instrument Sans",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "npm": "@fontsource/instrument-sans"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        500,
        600
      ],
      "use": "labels (uppercase, 0.12em tracking) and logbook numbers",
      "npm": "@fontsource/ibm-plex-mono"
    }
  },
  "radius": {
    "sm": 3,
    "md": 5,
    "lg": 6
  },
  "border": {
    "card": 1.5,
    "emphasis": 2
  },
  "shadow": {
    "hard": "3px 3px 0 var(--ll-shadow)"
  },
  "touchTarget": 44,
  "space": [
    4,
    6,
    8,
    10,
    12,
    14,
    16,
    20,
    24
  ],
  "contrast": {
    "rule": "Body text only uses ink or ink2. Brass is never small text. accent passes 4.5:1 as text on card in both themes."
  },
