{
  "name": "Paper & Iron",
  "themes": {
    "paper": {
      "paper": "#F2EADB",
      "card": "#FBF7EF",
      "panel": "#EDE3CF",
      "rule": "#D9CDB6",
      "ink": "#1D1B18",
      "ink2": "#5E574C",
      "line": "#1D1B18",
      "shadow": "#1D1B18",
      "accent": "#9E2B25",
      "onAccent": "#FBF7EF",
      "brass": "#B8862B",
      "onBrass": "#1D1B18",
      "brassText": "#7A5A12",
      "brassWash": "#F1E1B8",
      "ghost": "#CDBFA3",
      "equip": "#8E7F66",
      "equipDark": "#6B604E",
      "floor": "#C9BA9C",
      "farLimb": "#4A443B",
      "muscleBody": "#E8DFCC",
      "muscleIdle": "#D8CBB1",
      "musclePrimary": "#9E2B25",
      "muscleSecondary": "#D6A546"
    },
    "iron": {
      "paper": "#151412",
      "card": "#1F1D1A",
      "panel": "#2A2723",
      "rule": "#3B3731",
      "ink": "#EFE6D4",
      "ink2": "#B0A690",
      "line": "#4D473E",
      "shadow": "#000000",
      "accent": "#E0654C",
      "onAccent": "#151412",
      "brass": "#D6A546",
      "onBrass": "#151412",
      "brassText": "#E5BC60",
      "brassWash": "#3B3018",
      "ghost": "#4E483F",
      "equip": "#6E6352",
      "equipDark": "#9C8D74",
      "floor": "#3B3731",
      "farLimb": "#BDB29C",
      "muscleBody": "#36322C",
      "muscleIdle": "#4A443B",
      "musclePrimary": "#E0654C",
      "muscleSecondary": "#D6A546"
    }
  },
  "type": {
    "display": {
      "family": "Big Shoulders Display",
      "weights": [
        700,
        800,
        900
      ],
      "transform": "uppercase",
      "npm": "@fontsource/big-shoulders-display"
    },
    "body": {
      "family": "Instrument Sans",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "npm": "@fontsource/instrument-sans"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        500,
        600
      ],
      "use": "labels (uppercase, 0.12em tracking) and logbook numbers",
      "npm": "@fontsource/ibm-plex-mono"
    }
  },
  "radius": {
    "sm": 3,
    "md": 5,
    "lg": 6
  },
  "border": {
    "card": 1.5,
    "emphasis": 2
  },
  "shadow": {
    "hard": "3px 3px 0 var(--ll-shadow)"
  },
  "touchTarget": 44,
  "space": [
    4,
    6,
    8,
    10,
    12,
    14,
    16,
    20,
    24
  ],
  "contrast": {
    "rule": "Body text only uses ink or ink2. Brass is never small text. accent passes 4.5:1 as text on card in both themes."
  }
}
